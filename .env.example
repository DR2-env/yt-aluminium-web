# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.ytaluminium.com

# WhatsApp number in international format, digits only (e.g. 61451569228). Leave empty until confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WeChat ID shown on the contact and quote pages. Leave empty until confirmed.
NEXT_PUBLIC_WECHAT_ID=

# Quote requests sent from the website are emailed through Resend (resend.com).
# Without RESEND_API_KEY the quote page offers WhatsApp instead.
RESEND_API_KEY=
# Where quote requests arrive. Defaults to the business email.
QUOTE_TO_EMAIL=
# Sender address. Until a domain is verified in Resend, leave empty to use onboarding@resend.dev
# (Resend then only delivers to the email address the Resend account was created with).
QUOTE_FROM_EMAIL=

# Search engine ownership checks (optional). Paste only the code from the meta tag each tool gives you.
# Google Search Console: https://search.google.com/search-console  (HTML tag method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters  (also feeds ChatGPT search and Copilot)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
